{
    log {
        exclude http.log.access
    }
}
(aeo_ingress_headers) {
    header_up -CF-*
    header_up -X-Vercel-*
    header_up -CloudFront-Viewer-*
    header_up -EO-*
    header_up -X-Umami-IP
    header_up -X-Umami-Client-IP
    header_up -X-Umami-Country
    header_up -X-Umami-Region
    header_up -X-Umami-City
    header_up -X-Client-IP
    header_up -True-Client-IP
    header_up -Forwarded
    header_up -Authorization
    header_up -X-Aeo-*
}
{$AEO_STAGING_HOST} {
    header X-Robots-Tag "noindex, nofollow, noarchive"
    @intake path /api/send
    request_body @intake {
        max_size 128KB
    }
    log aeo_crawler_origin {
        no_hostname
        output file /data/aeo-crawler-access.log {
            mode 0600
            roll_interval 1h
            roll_size 1MiB
            roll_keep 24
            roll_keep_for 24h
            roll_uncompressed
        }
        format filter {
            wrap json
            fields {
                request delete
                resp_headers delete
                user_id delete
            }
        }
    }
    # Only allowlisted public origin requests traverse this logger. Keep the
    # bounded crawler UA and the authenticated edge IP needed for verification.
    @crawler_origin {
        method GET HEAD
        path / /robots.txt
        header X-Aeo-Origin-Key {$AEO_EDGE_ORIGIN_KEY}
        header X-Aeo-Public-Host aeo.io
        header_regexp crawler_ip X-Aeo-Client-IP ^[0-9a-fA-F:.]{1,45}$
        header_regexp crawler_ua User-Agent `(?i)^[ -~]{0,390}(bot|crawl|spider|slurp|fetcher|ChatGPT-User|Claude-User|Perplexity-User|Google-Extended|AEO-Crawl-Canary)[ -~]{0,90}$`
    }
    log_name @crawler_origin aeo_crawler_origin
    log_append @crawler_origin <path {http.request.uri.path}
    log_append @crawler_origin <method {http.request.method}
    log_append @crawler_origin <ip {http.request.header.X-Aeo-Client-IP}
    log_append @crawler_origin <ua {http.request.header.User-Agent}
    # Only the edge's dedicated secret permits asserted visitor identity.
    @edge {
        header X-Aeo-Origin-Key {$AEO_EDGE_ORIGIN_KEY}
        header X-Aeo-Public-Host aeo.io
        header X-Aeo-Public-Host staging.aeo.io
    }
    handle @edge {
        reverse_proxy app:3000 {
            import aeo_ingress_headers
            header_up Host {http.request.header.X-Aeo-Public-Host}
            header_up X-Forwarded-Host {http.request.header.X-Aeo-Public-Host}
            header_up X-Forwarded-Proto https
            header_up X-Real-IP {http.request.header.X-Aeo-Client-IP}
            header_up X-Forwarded-For {http.request.header.X-Aeo-Client-IP}
        }
    }
    handle {
        @private not path /script.js /api/send
        basic_auth @private {
            staging {$AEO_STAGING_PASSWORD_HASH}
        }
        reverse_proxy app:3000 {
            import aeo_ingress_headers
            # Direct requests have socket-derived identity; spoofed headers are ignored.
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
        }
    }
}
