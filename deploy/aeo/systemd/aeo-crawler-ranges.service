[Unit]
Description=Refresh AEO official crawler IP ranges
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/aeo-v2
ExecStart=/usr/bin/docker compose -f compose.yml -f compose.production.yml exec -T app node dist/aeo-crawler-ranges.mjs --refresh
TimeoutStartSec=10min
